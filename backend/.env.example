# Copie este arquivo para ".env" e preencha com os dados do seu app na Meta.
# NUNCA envie o arquivo .env para o GitHub nem para o front-end.

# --- Do painel Meta for Developers > Configurações > Básico ---
APP_ID=coloque_o_id_do_app
APP_SECRET=coloque_o_secret_do_app

# --- URL pública do SEU backend + /auth/instagram/callback ---
# Precisa ser HTTPS e estar cadastrada em "URIs de redirecionamento OAuth válidos".
REDIRECT_URI=https://seu-backend.onrender.com/auth/instagram/callback

# --- Você inventa este valor e repete no painel do webhook da Meta ---
WEBHOOK_VERIFY_TOKEN=uma_frase_secreta_que_voce_escolhe

# --- Chave que o CRM (front-end) usa para puxar os leads. Invente uma forte ---
CRM_API_KEY=outra_chave_secreta_forte

# --- Domínio do seu CRM (para CORS). Use "*" só em teste. ---
ALLOWED_ORIGIN=*

# Opcionais (já têm padrão):
# PORT=3000
# GRAPH_VERSION=v21.0
